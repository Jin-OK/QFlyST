  <property name="styleSheet">
   <string>
    * {
        color: #333333;
        font-family: "Microsoft YaHei", "PingFang SC", "Hiragino Sans GB", "Segoe UI", sans-serif;
    }
    QMainWindow { background-color: #f5f5f5; }
    QGroupBox {
        font-weight: bold;
        font-size: 11px;
        border: 1px solid #c0c0c0;
        border-radius: 3px;
        margin-top: 6px;
        padding-top: 6px;
        background-color: #ffffff;
    }
    QGroupBox::title {
        subcontrol-origin: margin;
        left: 8px;
        padding: 0 3px;
    }
    QLabel { color: #333333; background: transparent; }
    QPushButton {
        padding: 4px 10px;
        border: 1px solid #a0a0a0;
        border-radius: 2px;
        background-color: #f0f0f0;
        min-height: 22px;
    }
    QPushButton:hover { background-color: #e0e8ff; border-color: #5080ff; }
    QPushButton:pressed { background-color: #d0d8f0; }
    QPushButton:disabled { background-color: #e0e0e0; color: #808080; }
    QComboBox {
        padding: 3px 6px;
        border: 1px solid #a0a0a0;
        border-radius: 2px;
        background-color: #ffffff;
        color: #333333;
    }
    QComboBox:hover { border-color: #5080ff; }
    QComboBox::drop-down {
        border: none;
        width: 20px;
    }
    QComboBox QAbstractItemView {
        background-color: #ffffff;
        color: #333333;
        border: 1px solid #a0a0a0;
        selection-background-color: #e0e8ff;
        selection-color: #333333;
    }
    QLineEdit {
        padding: 3px 6px;
        border: 1px solid #a0a0a0;
        border-radius: 2px;
        background-color: #ffffff;
    }
    QCheckBox { spacing: 5px; }
    QCheckBox:hover { color: #0066cc; }
    QTextEdit {
        border: 1px solid #a0a0a0;
        background-color: #fafafa;
        font-family: &quot;Consolas&quot;, monospace;
        font-size: 9pt;
    }
    QMenuBar { background-color: #f5f5f5; border-bottom: 1px solid #c0c0c0; }
    QMenuBar::item { padding: 4px 8px; }
    QMenuBar::item:selected { background-color: #e0e8ff; }
    QMenu { background-color: #ffffff; border: 1px solid #c0c0c0; }
    QMenu::item { padding: 4px 20px; }
    QMenu::item:selected { background-color: #e0e8ff; }
    QStatusBar { background-color: #f0f0f0; border-top: 1px solid #c0c0c0; }
    QProgressBar {
        border: 1px solid #a0a0a0;
        background-color: #ffffff;
        text-align: center;
    }
    QProgressBar::chunk { background-color: #4CAF50; }
   </string>
